<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd"
        logicalFilePath="db/changelog/changelog.xml">

        <changeSet id="create-bot-data-tables" author="vKvs">
            <createSequence sequenceName="bot_data_user_id_seq"
                            schemaName="bot_data_schema"
                            dataType="BIGINT"
                            startValue="1"
                            minValue="1"
                            incrementBy="10"/>

            <createTable tableName="bot_data_user" schemaName="bot_data_schema">
                <column name="id" type="BIGINT">
                    <constraints primaryKey="true" unique="true" nullable="false"/>
                </column>

                <column name="user_id" type="BIGINT">
                    <constraints unique="true"/>
                </column>

                <column name="chat_id" type="BIGINT">
                    <constraints unique="true"/>
                </column>

                <column name="name" type="VARCHAR(255)"/>

                <column name="user_name" type="VARCHAR(255)"/>

                <column name="bot_state" type="VARCHAR(50)"/>
            </createTable>
        </changeSet>
</databaseChangeLog>